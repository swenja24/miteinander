GHCR_IMAGE=ghcr.io/swenja24/miteinander
IMAGE_TAG=latest
HOST_PORT=3080

# POSTGRES_PASSWORD nur mit Hex-Zeichen erzeugen: `openssl rand -hex 32`.
# Für DJANGO_SECRET_KEY eignet sich `openssl rand -base64 48`.
POSTGRES_PASSWORD=BITTE-EINEN-ZUFAELLIGEN-WERT-EINTRAGEN
DJANGO_SECRET_KEY=BITTE-EINEN-LANGEN-ZUFAELLIGEN-WERT-EINTRAGEN

# Hostname ohne Schema; mehrere Werte mit Komma trennen.
ALLOWED_HOSTS=miteinander.example.de
CSRF_TRUSTED_ORIGINS=https://miteinander.example.de
APP_BASE_URL=https://miteinander.example.de
COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
# Inaktive Sitzungen laufen standardmäßig nach acht Stunden ab.
SESSION_COOKIE_AGE_SECONDS=28800

# Wird ausschließlich bei einer leeren Installation verwendet.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=BITTE-MINDESTENS-12-ZEICHEN-EINTRAGEN
BOOTSTRAP_ADMIN_NAME=Dein Name
BOOTSTRAP_ADMIN_ROLE=Gesetzliche Betreuung
BOOTSTRAP_PERSON_NAME=Linea
BOOTSTRAP_WORKSPACE_NAME=Lineas Bereich

AUDIT_RETENTION_DAYS=730
# Maximale Summe hochgeladener Dateien pro Bereich in MiB.
WORKSPACE_STORAGE_LIMIT_MB=2048
DATA_CONTROLLER_NAME=
DATA_CONTROLLER_CONTACT=
DEVELOPER_CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Optional: S3-kompatibler Speicher für Uploads. Leer lassen für das Docker-Volume.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=eu-central-1
